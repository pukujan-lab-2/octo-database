# Multi-stage Dockerfile for octo-web (Vite build + Caddy static server/reverse proxy)
FROM node:22-bookworm-slim AS builder
WORKDIR /app

COPY package.json package-lock.json ./
# The app is built from frontend, carrying its own dependency tree; the root
# install alone would not pull it in. `.npmrc` must come along too: it sets
# legacy-peer-deps, without which the install fails on peers.
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./frontend/
RUN npm ci && npm --prefix frontend ci

COPY . .
RUN npm run build

# Caddy with Sablier's plugin, which starts Phoenix and the embedder on request and
# lets Sablier stop them when idle (#448).
FROM caddy:2.11.2-builder AS caddy
RUN xcaddy build --with github.com/sablierapp/sablier-caddy-plugin@v1.0.2

FROM caddy:2.11.2-alpine
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY --from=builder /app/dist /srv
COPY deploy/gravebuster/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
